{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "preserve",
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "node",
    "allowJs": true,
    "noEmit": true
  },
  "exclude": ["node_modules", ".next"]
}